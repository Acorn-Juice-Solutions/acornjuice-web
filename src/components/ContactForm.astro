---
import { type Locale, useTranslator } from '~/utils/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslator(locale);

// Same allowlisted URL for both languages; staticforms.dev decides destination
// via the API key. Shared with the AccuVideo landing (same value in that
// repo's index.html and main.js): rotating this affects both sites.
// staticforms.dev keys are designed to be public — allowlisting is enforced
// server-side by origin, so acornjuice.com must be on the allowlist for this
// key in the staticforms.dev dashboard for submissions to be accepted.
const STATIC_FORMS_API_KEY = 'sf_4d32929fdc91426750c7d382';
const STATIC_FORMS_ENDPOINT = 'https://api.staticforms.dev/submit';

const successPath = locale === 'es' ? '/es/gracias/' : '/thanks/';
const privacyPath = locale === 'es' ? '/es/privacidad/' : '/privacy/';
---

<form
  class="contact-form"
  data-contact-form
  action={STATIC_FORMS_ENDPOINT}
  method="POST"
  novalidate
>
  <input type="hidden" name="apiKey" value={STATIC_FORMS_API_KEY} />
  <input
    type="hidden"
    name="subject"
    value="acornjuice.com contact form"
  />
  <input type="hidden" name="_locale" value={locale} />
  <input
    type="hidden"
    name="_success_redirect"
    value={successPath}
  />

  {/*
    Honeypot — invisible to humans, catches most bots. No <label>: the
    container is aria-hidden and the input is not focusable via Tab, so
    a visible label would only introduce a dangling audit warning
    ("label without accessible control"). Bots key off name="website"
    to fill it in — the label is not what makes the trap work.
  */}
  <div class="hp-field" aria-hidden="true">
    <input
      type="text"
      name="website"
      tabindex="-1"
      autocomplete="off"
      value=""
    />
  </div>

  <p
    class="form-service-banner"
    role="alert"
    data-form-service-banner
    hidden
  >
    {t('contact.error_body')}
  </p>

  <div class="form-row">
    <label for="contact-email">
      <span>{t('contact.field_email')}</span>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
      />
    </label>
  </div>

  <div class="form-row">
    <label for="contact-subject">
      <span>{t('contact.field_subject')}</span>
      <select id="contact-subject" name="topic" required>
        <option value="general">{t('contact.subject_general')}</option>
        <option value="products">{t('contact.subject_products')}</option>
        <option value="quote">{t('contact.subject_quote')}</option>
        <option value="other">{t('contact.subject_other')}</option>
      </select>
    </label>
  </div>

  <div class="form-row">
    <label for="contact-message">
      <span>{t('contact.field_message')}</span>
      <textarea
        id="contact-message"
        name="message"
        required
        rows="5"
        autocomplete="off"></textarea>
    </label>
  </div>

  <label class="form-consent">
    <input
      type="checkbox"
      name="data_consent"
      value="yes"
      required
      checked
    />
    <span>
      {t('contact.consent_label')}
      <a href={privacyPath}>{t('footer.privacy')}</a>.
    </span>
  </label>

  <button
    type="submit"
    class="btn btn-primary contact-submit"
    data-submit-label={t('contact.submit')}
    data-submitting-label={t('contact.sending')}
  >{t('contact.submit')}</button>
</form>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]');

  forms.forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>('.contact-submit');
    const banner = form.querySelector<HTMLElement>('[data-form-service-banner]');
    const successPath = form.querySelector<HTMLInputElement>(
      'input[name="_success_redirect"]',
    )?.value;

    form.addEventListener('submit', async (event) => {
      // Honeypot filled = silently drop
      const hp = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (hp && hp.value.trim() !== '') {
        event.preventDefault();
        return;
      }

      if (!form.checkValidity()) {
        return; // let native validation UI show
      }

      event.preventDefault();

      if (submit) {
        const submitting = submit.dataset.submittingLabel;
        if (submitting) {
          submit.textContent = submitting;
        }
        submit.disabled = true;
      }
      if (banner) {
        banner.hidden = true;
      }

      try {
        const formData = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        if (!res.ok) {
          throw new Error(`Status ${res.status}`);
        }

        if (successPath) {
          window.location.assign(successPath);
        }
      } catch {
        if (banner) {
          banner.hidden = false;
        }
        if (submit) {
          const label = submit.dataset.submitLabel;
          if (label) {
            submit.textContent = label;
          }
          submit.disabled = false;
        }
      }
    });
  });
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--reading-max);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    top: 0;
    visibility: hidden;
    height: 0;
    width: 0;
  }

  .form-row label,
  .form-consent {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .form-row input,
  .form-row select,
  .form-row textarea {
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .form-row textarea {
    resize: vertical;
    min-height: 8rem;
    font-family: var(--font-body);
  }

  .form-row input:focus,
  .form-row select:focus,
  .form-row textarea:focus {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 3px var(--color-focus-ring);
    outline: none;
  }

  .form-consent {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .form-consent input[type='checkbox'] {
    margin-top: 3px;
  }

  .contact-submit {
    align-self: flex-start;
  }

  .form-service-banner {
    background: rgba(160, 82, 45, 0.08);
    border: 1px solid var(--color-cap);
    color: var(--color-cap-dark);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
  }
</style>
