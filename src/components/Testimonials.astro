---
import { useTranslator, interpolate, type Locale } from '~/utils/i18n';
import { TESTIMONIALS, type StarRating } from '~/data/testimonials';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslator(locale);

const heading = t('home.testimonials.heading');
const lede = t('home.testimonials.lede');
const regionLabel = t('home.testimonials.aria_region');
const ratingTemplate = t('home.testimonials.aria_rating');

// Server-side render is per request; a single formatter per render is fine.
const dateFormatter = new Intl.DateTimeFormat(
  locale === 'es' ? 'es-ES' : 'en-US',
  { month: 'short', year: 'numeric' },
);

function formatDate(iso: `${number}-${number}`): string {
  const [year, month] = iso.split('-').map(Number);
  // Day 1 in UTC avoids DST/timezone edge cases when formatting month/year.
  return dateFormatter.format(new Date(Date.UTC(year, month - 1, 1)));
}

const ratingLabel = (rating: StarRating): string =>
  interpolate(ratingTemplate, { count: rating });

// Show a curated subset in a single row. The full data file keeps the rest as
// a rotation reserve. Duplicated inline so the CSS marquee loops seamlessly at
// translateX(-50%); the duplicated half is aria-hidden so assistive tech only
// announces each testimonial once.
const VISIBLE_COUNT = 10;
const visible = TESTIMONIALS.slice(0, VISIBLE_COUNT);
const visibleDup = [...visible, ...visible];
---

<section class="testimonials section">
  <div class="container">
    <h2>{heading}</h2>
    <p class="section-lede">{lede}</p>

    <div class="marquee" role="region" aria-label={regionLabel}>
      <ul class="marquee-track">
        {
          visibleDup.map((item, i) => (
            <li
              class="testimonial-card"
              aria-hidden={i >= visible.length ? 'true' : undefined}
            >
              <div class="stars" aria-label={ratingLabel(item.rating)} role="img">
                {Array.from({ length: 5 }, (_, idx) => (
                  <svg
                    class:list={['star', { 'star--on': idx < item.rating }]}
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M10 1.5l2.6 5.3 5.9.85-4.25 4.14 1 5.86L10 14.9l-5.25 2.76 1-5.86L1.5 7.65l5.9-.85z" />
                  </svg>
                ))}
              </div>
              <p class="quote">{item.text[locale]}</p>
              <p class="meta">
                <span class="name">{item.name}</span>
                <span class="date">{formatDate(item.date)}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .marquee {
    /* Perceived pace ~50px/s at desktop card width — comfortable to read
       without feeling static. Tuned when scaling card count / width. */
    --marquee-duration: 140s;
    margin-top: var(--space-6);
    position: relative;
    overflow: hidden;
    /* Soft fade at horizontal edges so cards enter/exit without a hard cut. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 5%,
      #000 95%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 5%,
      #000 95%,
      transparent 100%
    );
  }

  .marquee-track {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-4);
    width: max-content;
    animation: marquee-scroll var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  /* Pause when a pointer is over the marquee or when a focusable element
     inside it gains focus (keyboard accessibility). */
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .testimonial-card {
    flex: 0 0 20rem;
    min-height: 12rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stars {
    display: flex;
    gap: 2px;
  }

  .star {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1.5;
  }

  .star--on {
    fill: var(--color-body);
    stroke: var(--color-body);
  }

  .quote {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    font-style: italic;
  }

  .meta {
    margin: 0;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .name {
    font-weight: 600;
    color: var(--color-ink);
  }

  .date {
    text-transform: capitalize;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }
    /* Hide the duplicated half — we only need the unique cards when static. */
    .marquee-track > [aria-hidden='true'] {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .testimonial-card {
      flex: 0 0 17rem;
      min-height: 11rem;
    }
    .marquee {
      --marquee-duration: 110s;
    }
  }
</style>
