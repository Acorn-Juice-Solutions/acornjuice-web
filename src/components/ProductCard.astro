---
import type { CollectionEntry } from 'astro:content';
import { type Locale, useTranslator } from '~/utils/i18n';

interface Props {
  product: CollectionEntry<'products'>;
  locale: Locale;
}

const { product, locale } = Astro.props;
const t = useTranslator(locale);

const data = product.data;
const tagline = data.tagline[locale];
const name = data.name;
const slugForLocale = locale === 'es' ? data.slugEs : data.slug;
const productPath =
  locale === 'es' ? `/es/productos/${slugForLocale}/` : `/products/${slugForLocale}/`;

const isDraft = data.status === 'draft';
const statusLabel = t(`products.status_${data.status}` as const);

const platformLabels: Record<string, string> = {
  ios: 'iOS',
  android: 'Android',
  windows: 'Windows',
  macos: 'macOS',
  linux: 'Linux',
  web: 'Web',
  github: 'GitHub',
};
---

<article class:list={['product-card', isDraft && 'product-card--draft']}>
  <div class="product-card-header">
    <h3 class="product-card-name">
      <a href={productPath}>{name}</a>
    </h3>
    <span
      class:list={[
        'product-card-status',
        isDraft && 'product-card-status--soft',
      ]}
    >{statusLabel}</span>
  </div>

  <p class="product-card-tagline">{tagline}</p>

  <ul class="product-card-platforms" aria-label="Platforms">
    {
      data.platforms.map((p) => (
        <li>{platformLabels[p] ?? p}</li>
      ))
    }
  </ul>

  <a href={productPath} class="product-card-cta">
    {t('products.learn_more')} →
  </a>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    transition: transform var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }

  .product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(42, 26, 16, 0.06);
  }

  .product-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .product-card-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .product-card-name a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .product-card-name a:hover {
    color: var(--color-cap-dark);
  }

  .product-card-status {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-cap);
    font-weight: 700;
  }

  .product-card-status--soft {
    color: var(--color-ink-soft);
  }

  .product-card--draft {
    background: var(--color-bg-alt);
  }

  .product-card-tagline {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-base);
  }

  .product-card-platforms {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .product-card-platforms li {
    display: inline-block;
    padding: 2px var(--space-2);
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .product-card-cta {
    align-self: flex-start;
    margin-top: auto;
    color: var(--color-cap);
    font-weight: 600;
    text-decoration: none;
  }

  .product-card-cta:hover {
    text-decoration: underline;
  }
</style>
