---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '~/utils/i18n';

interface Props {
  maker: CollectionEntry<'makers'>;
  locale: Locale;
}

const { maker, locale } = Astro.props;
const data = maker.data;
const role = data.role[locale];
const bio = data.bio[locale];
---

<article class="maker-card">
  <header class="maker-header">
    <h3 class="maker-name">{data.name}</h3>
    <p class="maker-role">{role}</p>
  </header>

  <p class="maker-bio">{bio}</p>

  <ul class="maker-skills" aria-label="Skills">
    {data.skills.map((s) => <li>{s}</li>)}
  </ul>

  <div class="maker-links">
    <a href={data.linkedin} rel="noopener me" target="_blank">LinkedIn</a>
    {
      data.github && (
        <a href={data.github} rel="noopener me" target="_blank">GitHub</a>
      )
    }
  </div>
</article>

<style>
  .maker-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .maker-header {
    margin-bottom: var(--space-2);
  }

  .maker-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-1);
    color: var(--color-ink);
  }

  .maker-role {
    margin: 0;
    color: var(--color-cap);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .maker-bio {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .maker-skills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .maker-skills li {
    padding: 2px var(--space-2);
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--color-ink-soft);
  }

  .maker-links {
    display: flex;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .maker-links a {
    font-weight: 600;
    text-decoration: none;
    color: var(--color-cap);
  }

  .maker-links a:hover {
    color: var(--color-cap-dark);
    text-decoration: underline;
  }
</style>
