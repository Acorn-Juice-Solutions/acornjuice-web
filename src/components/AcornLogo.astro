---
interface Props {
  size?: number;
  title?: string;
  class?: string;
}

const { size = 32, title = 'Acorn Juice Solutions', class: className = '' } =
  Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  role="img"
  aria-label={title}
  class:list={['acorn-logo', className]}
>
  <title>{title}</title>
  {/*
    Simplified two-tone acorn mark. The cap uses the brand brown, the body the
    warm amber. Detail patterns (chevron on the cap, binary on the body) live
    in the full logo asset in /public/assets/logo.svg; this inline component
    is the compact variant used for header/footer where it needs to scale
    down cleanly.
  */}
  <g fill="none" stroke="none">
    <path
      d="M32 4v5"
      stroke="var(--color-cap-dark, #7a3e20)"
      stroke-width="2.5"
      stroke-linecap="round"
      fill="none"
    ></path>
    <path
      d="M32 9c-10 0-16 3-16 8 0 3 1 5 3 6 3 1 23 1 26 0 2-1 3-3 3-6 0-5-6-8-16-8z"
      fill="var(--color-cap, #a0522d)"
    ></path>
    <path
      d="M18 24c-1 0-1.5 1-1.2 2 1.5 11 6 24 15.2 32 9.2-8 13.7-21 15.2-32 0.3-1-0.2-2-1.2-2z"
      fill="var(--color-body, #e8934a)"
    ></path>
  </g>
</svg>
