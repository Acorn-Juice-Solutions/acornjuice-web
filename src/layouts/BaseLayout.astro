---
import '~/styles/globals.css';
// Import the primary latin font subsets as URLs so we can emit <link rel=preload>
// tags with the same hashed filenames Vite bakes into the inlined @font-face
// rules. This turns the (inlined) HTML → font critical dependency into two
// parallel fetches instead of a serial chain, which is what Lighthouse's
// network-dependency-tree insight scores against.
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import newsreaderLatinUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import SiteHeader from '~/components/SiteHeader.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import StructuredData from '~/components/StructuredData.astro';
import ConsentBanner from '~/components/ConsentBanner.astro';
import {
  canonicalUrl,
  getHreflangs,
  isNoindex,
} from '~/utils/hreflang';
import { getLocaleFromUrl, htmlLangAttr, ogLocale, type Locale } from '~/utils/i18n';
import { buildGraph, type SchemaGraph } from '~/utils/seo';
import {
  GA_MEASUREMENT_ID,
  analyticsEnabled,
  type PageType,
} from '~/utils/analytics';

interface Props {
  title: string;
  description: string;
  extraGraphNodes?: Parameters<typeof buildGraph>[1];
  ogImage?: string;
  ogType?: 'website' | 'article';
  /**
   * When true, the cookie banner is server-rendered hidden (used on legal
   * pages so users reading the policy don't get a banner covering it).
   * The footer "Manage preferences" button still opens it.
   */
  hideConsentBanner?: boolean;
  /**
   * GA4 content-group value for this page. Surfaced as `data-page-type` on
   * `<html>` and consumed by ConsentBanner to enrich every `page_view` with
   * `content_group`, so we can segment by page kind independently of URL or
   * language.
   */
  pageType: PageType;
}

const {
  title,
  description,
  extraGraphNodes,
  ogImage = '/og/default.png',
  ogType = 'website',
  hideConsentBanner = false,
  pageType,
} = Astro.props;

const locale: Locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const canonical = canonicalUrl(currentPath);
const alternates = getHreflangs(currentPath);
const noindex = isNoindex(currentPath);

const ogImageAbsolute = new URL(ogImage, Astro.site).toString();
const graph: SchemaGraph = buildGraph(locale, extraGraphNodes ?? []);

const gaId = analyticsEnabled() ? GA_MEASUREMENT_ID : '';
---

<!doctype html>
<html
  lang={htmlLangAttr(locale)}
  data-ga-measurement-id={gaId || undefined}
  data-page-type={pageType}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Content-Security-Policy. Declared in a meta tag because GitHub Pages
      serves static files and gives us no way to set response headers; that
      rules out frame-ancestors and report-uri, which are header-only.

      The directive that matters most here is not script-src but connect-src
      and form-action. Google Analytics is a script we choose to run, so the
      realistic risk is not Google serving malware — it is that any script
      running in this page can read the DOM and post it anywhere. Pinning where
      data is allowed to go is what limits the damage.

      'unsafe-inline' is unavoidable: the consent bootstrap, the anti-flash
      theme script and the JSON-LD block are all inline, and Pages cannot
      generate per-request nonces.

      Keep this in sync with scripts/check-external-origins.mjs, which fails the
      build when dist/ references an origin that is not listed in both places.
    */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://api.staticforms.dev; form-action 'self' https://api.staticforms.dev; base-uri 'self'; object-src 'none'; frame-src 'none'"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    {
      noindex ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <meta
          name="robots"
          content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
        />
      )
    }

    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:site_name" content="Acorn Juice Solutions" />
    <meta property="og:locale" content={ogLocale(locale)} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <meta name="theme-color" content="#a0522d" />
    <meta name="author" content="Acorn Juice Solutions" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <link
      rel="preload"
      href={interLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={newsreaderLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <StructuredData graph={graph} />

    {/*
      Anti-flash consent detection: runs synchronously before body renders.
      If the user already has a decision in localStorage, mark the html so CSS
      can hide the banner immediately (no flash). Otherwise the banner shows
      on first paint for first-time visitors.
    */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('aj-consent-v1');
          if (v) {
            document.documentElement.setAttribute(
              'data-consent-decided',
              'true'
            );
          }
        } catch (e) {
          /* localStorage disabled */
        }
      })();
    </script>
    <style is:global>
      html[data-consent-decided] [data-consent-banner]:not(.consent-force-open) {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <SiteHeader locale={locale} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <ConsentBanner locale={locale} hidden={hideConsentBanner} />
  </body>
</html>
