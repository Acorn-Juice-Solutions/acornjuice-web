# Do not run dependency lifecycle scripts on install.
#
# Both the September 2025 Shai-Hulud worm and its November 2025 successor
# executed in install hooks: the compromised version was published with a
# stolen maintainer token, so it was correctly signed and looked legitimate to
# every signature check. The hook is the part that actually runs code.
#
# The cost here is close to zero. Of the 756 packages in package-lock.json,
# exactly two declare an install script: esbuild (rebuilt explicitly by the
# `ci:install` script) and fsevents (macOS-only and optional).
#
# Note this also disables lifecycle scripts for this package itself on install,
# which is fine because it declares none. Scripts invoked directly with
# `npm run <name>` are unaffected.
ignore-scripts=true
